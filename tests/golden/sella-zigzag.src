DEF Pezzo1 ( )
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )

;FOLD INI
BAS (#INITMOV,0)
BAS (#VEL_PTP,50)
BAS (#ACC_PTP,100)
;ENDFOLD

;FOLD STARTPOS
$BWDSTART = FALSE
PDAT_ACT = {VEL 50,ACC 100,APO_DIST 10}
BAS(#PTP_DAT)
FDAT_ACT = {TOOL_NO 0,BASE_NO 0,IPO_FRAME #BASE}
BAS (#FRAMES)
BAS (#VEL_PTP,50)
;ENDFOLD

;FOLD SET DEFAULT SPEED
$VEL.CP=0.8
BAS(#VEL_PTP,50)
BAS(#TOOL,0)
BAS(#BASE,0)
;ENDFOLD

;FOLD PTP FIRST POSITION
$BWDSTART = FALSE
PDAT_ACT = {VEL 50,ACC 100,APO_DIST 10}
FDAT_ACT = {TOOL_NO 0,BASE_NO 0,IPO_FRAME #BASE}
BAS(#FRAMES)
$ADVANCE = 5
;ENDFOLD

PTP $AXIS_ACT ; skip BCO quickly

$OUT[6]=FALSE
$OUT[7]=TRUE
$OUT[8]=FALSE
$OUT[9]=TRUE

; =========================
; ESTRUSORE SPENTO IN AVVIO
; ANOUT[7] = ON/OFF ESTRUSORE
; ANOUT[6] = VELOCITA ESTRUSORE
; =========================
$ANOUT[7]=0
$OUT[16]=FALSE
$ANOUT[6]=0

WAIT SEC 1

$BASE=BASE_DATA[1]
$TOOL=TOOL_DATA[11]
$VEL.CP=0.8

; =========================
; POSIZIONE SICURA
; A5 = -1 PER EVITARE SINGOLARITA
; =========================
PTP {A1 0.000, A2 -90.000, A3 90.000, A4 0.000, A5 -1.000, A6 0.000, E1 0, E2 0, E3 0, E4 0, E5 0, E6 0}

; =========================
; POSIZIONE ASSE LINEARE
; ESTRUSORE ANCORA SPENTO
; =========================
PTP {A1 0.000, A2 -90.000, A3 90.000, A4 0.000, A5 -1.000, A6 0.000, E1 0, E2 0, E3 0, E4 0, E5 0, E6 0}

; =========================
; AVVICINAMENTO AL PRIMO PUNTO
; ESTRUSORE SPENTO
; =========================
PTP {X -120.000, Y 390.000, Z 38.500, A -180.000, B 0.000, C 180.000, E1 0.000, E2 0.000, E3 0.000, E4 0.000}

; =========================
; PRIMO PUNTO REALE
; ANCORA SENZA ESTRUSIONE
; =========================
LIN {X -120.000, Y 390.000, Z 38.500, A -180.000, B 0.000, C 180.000, E1 0.000, E2 0.000, E3 0.000, E4 0.000} C_DIS

; =========================
; ACCENSIONE ESTRUSORE
; ANOUT[6] = 10 CORRISPONDE A 100%
; =========================
$ANOUT[6]=2
$ANOUT[7]=1
WAIT SEC 1
$OUT[16]=TRUE

; =========================
; INIZIO STAMPA
; =========================
LIN {X 130.000, Y 390.000, Z 38.500, A -180.000, B 0.000, C 180.000, E1 0.000, E2 0.000, E3 0.000, E4 0.000} C_DIS
